# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PRO_PRICE_ID=price_your_pro_price_id
VITE_STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id

# Audio Processing API
VITE_AUDIO_API_URL=http://localhost:3001/api/audio

# OpenAI/Anthropic (Optional - for AI features)
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key

# IPFS/Arweave (Optional - for decentralized storage)
VITE_PINATA_API_KEY=your-pinata-api-key
VITE_PINATA_SECRET_KEY=your-pinata-secret-key
VITE_ARWEAVE_WALLET_KEY=your-arweave-wallet-key

# Blockchain APIs (Optional - for on-chain data)
VITE_AIRSTACK_API_KEY=your-airstack-api-key
VITE_RESERVOIR_API_KEY=your-reservoir-api-key
VITE_ETHERSCAN_API_KEY=your-etherscan-api-key
